@page
@model BatteryPeykCustomers.Pages.ExpensePages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].CounterpartyId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].ReasonId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].Reason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].Counterparty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Expense[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Expense) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Date)
            </td>
            <td>
                @Html.DisplayFor(model => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(model => item.CounterpartyId)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReasonId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Reason)
            </td>
            <td>
                @Html.DisplayFor(model => item.Counterparty)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
